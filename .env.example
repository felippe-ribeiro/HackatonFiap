# ============================================================
# Lária — Agente SDR Imobiliário  |  configuração de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# ============================================================

# --- OpenAI (obrigatório para respostas reais da IA) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.4

# Sem chave? Deixe em branco/placeholder e ligue o modo simulado:
# o agente responde com um motor determinístico (bom para demo/testes).
USE_FAKE_LLM=false

# --- Banco de dados ---
DATABASE_URL=sqlite:///./data/laria.db

# --- Índice RAG ---
RAG_INDEX_DIR=./data/index
RAG_TOP_K=4

# --- Follow-up automático ---
FOLLOWUP_ENABLED=true
FOLLOWUP_AFTER_HOURS=24
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_SCAN_INTERVAL_MINUTES=30

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# --- Integração WhatsApp (opcional / diferencial) ---
WHATSAPP_VERIFY_TOKEN=troque-este-token

# --- Integração Telegram (opcional / diferencial) ---
# Crie um bot com o @BotFather e cole o token aqui. Depois:
#   python -m app.channels.telegram   (modo long-polling, sem URL pública)
TELEGRAM_BOT_TOKEN=
